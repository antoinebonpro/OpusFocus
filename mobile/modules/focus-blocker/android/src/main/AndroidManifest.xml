<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <!-- Session : service au premier plan (compte à rebours), notification de fin, reprise après redémarrage. -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
  <!-- « Ne pas déranger » pendant la session (accès accordé par l'utilisateur dans les réglages). -->
  <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />

  <queries>
    <!-- Liste des applications installées (uniquement celles qui ont une icône dans le lanceur). -->
    <intent>
      <action android:name="android.intent.action.MAIN" />
      <category android:name="android.intent.category.LAUNCHER" />
    </intent>
    <!-- Reconnaître les navigateurs. -->
    <intent>
      <action android:name="android.intent.action.VIEW" />
      <data android:scheme="https" />
    </intent>
  </queries>

  <application>
    <service
      android:name=".FocusBlockerService"
      android:exported="false"
      android:label="@string/focus_blocker_service_label"
      android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
      <intent-filter>
        <action android:name="android.accessibilityservice.AccessibilityService" />
      </intent-filter>
      <meta-data
        android:name="android.accessibilityservice"
        android:resource="@xml/focus_blocker_accessibility" />
    </service>

    <service
      android:name=".SessionService"
      android:exported="false"
      android:foregroundServiceType="specialUse">
      <property
        android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
        android:value="Minuteur de session de concentration : lève les blocages et prévient l'utilisateur à l'heure prévue." />
    </service>

    <service
      android:name=".DnsVpnService"
      android:exported="false"
      android:permission="android.permission.BIND_VPN_SERVICE">
      <intent-filter>
        <action android:name="android.net.VpnService" />
      </intent-filter>
    </service>

    <receiver
      android:name=".BootReceiver"
      android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.BOOT_COMPLETED" />
        <action android:name="android.intent.action.QUICKBOOT_POWERON" />
      </intent-filter>
    </receiver>

    <receiver
      android:name=".SessionEndReceiver"
      android:exported="false" />

    <activity
      android:name=".BlockActivity"
      android:exported="false"
      android:excludeFromRecents="true"
      android:launchMode="singleTask"
      android:taskAffinity="expo.modules.focusblocker.block"
      android:theme="@android:style/Theme.DeviceDefault.NoActionBar" />
  </application>
</manifest>
